@startuml Latency_Distribution_Chapter_5
!theme vibrant
skinparam backgroundColor #0f172a
skinparam ArrowColor #38bdf8
skinparam ParticipantBorderColor #38bdf8
skinparam ParticipantBackgroundColor #1e293b
skinparam ParticipantFontColor #f8fafc

' Measured values: evaluation/results/final_v3.2.0 and evaluation/results/locust (CPU inference).
title Analysis Request — Measured Latency (v3.2.0, CPU, single Uvicorn worker)

actor "Browser Extension" as Client
participant "FastAPI Gateway (ASGI)" as Gateway
participant "BERT worker thread" as BERT
participant "Mule scanner + SQLite" as Mule
participant "Verdict engine" as Verdict

Client -> Gateway : POST /api/v1/analyze/semantics
alt whitelisted domain
    Gateway --> Client : SAFE (server time mean 0.28 ms)
else other domains
    par asyncio.gather
        Gateway -> BERT : predict(strip_scheme(url))
        BERT --> Gateway : label, confidence (mean 108 ms per URL, single client)
    else
        Gateway -> Mule : scan_and_verify(text)
        Mule --> Gateway : flagged accounts
    end
    Gateway -> Verdict : decide(signals) -> rules R1–R6
    Verdict --> Gateway : verdict, rule, indicators
    Gateway --> Client : 200 AnalysisResponse
end

note over Client, Gateway
  Locust, 50 users, 60 s: 22.4 req/s, 0 errors, p50 13 ms, p95 370 ms, p99 490 ms
  Uncached BERT path: p50 190 ms, p95 450 ms
  200 users: no errors; BERT path saturates at ~10.7 req/s (median 9.7 s)
end note

@enduml

