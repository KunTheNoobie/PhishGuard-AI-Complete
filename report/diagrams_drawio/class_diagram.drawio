<mxfile host="drawio" type="device"><diagram name="class_diagram" id="class_diagram"><mxGraphModel dx="1200" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1169" pageHeight="827" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="class_diagram-1" value='&lt;p style="margin:0;margin-top:4px;text-align:center;"&gt;&lt;i&gt;«singleton»&lt;/i&gt;&lt;br&gt;&lt;b&gt;SemanticEngine&lt;/b&gt;&lt;/p&gt;&lt;hr size="1" style="border-style:solid;"&gt;&lt;p style="margin:0;margin-left:6px;"&gt;- _tokenizer&lt;br&gt;- _model: BertForSequenceClassification&lt;/p&gt;&lt;hr size="1" style="border-style:solid;"&gt;&lt;p style="margin:0;margin-left:6px;"&gt;+ warm_up()&lt;br&gt;- _run_inference(text) → dict&lt;br&gt;+ async predict(text) → dict&lt;br&gt;+ shutdown()&lt;/p&gt;' style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontFamily=Consolas;fontSize=10;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="10" y="10" width="300" height="150" as="geometry"/></mxCell><mxCell id="class_diagram-2" value='&lt;p style="margin:0;margin-top:4px;text-align:center;"&gt;&lt;i&gt;«module»&lt;/i&gt;&lt;br&gt;&lt;b&gt;verdict_engine&lt;/b&gt;&lt;/p&gt;&lt;hr size="1" style="border-style:solid;"&gt;&lt;p style="margin:0;margin-left:6px;"&gt;+ decide(...) → Verdict&lt;br&gt;+ collect_signals(...) → dict&lt;br&gt;+ has_credential_form(html)&lt;br&gt;+ has_credential_text(text)&lt;br&gt;+ has_scam_language(text)&lt;/p&gt;' style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#F8CECC;strokeColor=#B85450;fontFamily=Consolas;fontSize=10;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="10" y="190" width="300" height="130" as="geometry"/></mxCell><mxCell id="class_diagram-3" value='&lt;p style="margin:0;margin-top:4px;text-align:center;"&gt;&lt;i&gt;«dataclass»&lt;/i&gt;&lt;br&g