1A;fontSize=10;align=center;verticalAlign=middle;spacing=6;strokeWidth=1.1;" vertex="1" parent="1"><mxGeometry x="20" y="320" width="250" height="120" as="geometry"/></mxCell><mxCell id="class_diagram-8" value="&lt;span style=&quot;font-size:10px&quot;&gt;«singleton»&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size:12px&quot;&gt;MuleScanner&lt;/b&gt;&lt;hr style=&quot;margin:3px 0&quot;&gt;&lt;span style=&quot;font-size:10px&quot;&gt;+ async scan_and_verify(text, db)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;extract_accounts(text)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;normalise_account(raw)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;queries repository&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontFamily=Arial;fontColor=#1A1A1A;fontSize=10;align=center;verticalAlign=middle;spacing=6;strokeWidth=1.1;" vertex="1" parent="1"><mxGeometry x="310" y="320" width="250" height="120" as="geometry"/></mxCell><mxCell id="class_diagram-9" value="&lt;span style=&quot;font-size:10px&quot;&gt;«Module 2»&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size:12px&quot;&gt;VisualLogoDetector&lt;/b&gt;&lt;hr style=&quot;margin:3px 0&quot;&gt;&lt;span style=&quot;font-size:10px&quot;&gt;- _model: YOLO (lazy)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;+ detect(screenshot)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;evaluate_logo_domain(url, logos)&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontFamily=Arial;fontColor=#1A1A1A;fontSize=10;align=center;verticalAlign=middle;spacing=6;strokeWidth=1.1;" vertex="1" parent="1"><mxGeometry x="600" y="320" width="250" height="120" as="geometry"/></mxCell><mxCell id="class_diagram-10" value="&lt;span style=&quot;font-size:10px&quot;&gt;«module»&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size:12px&quot;&gt;brand_profiler + core.brands&lt;/b&gt;&lt;hr style=&quot;margin:3px 0&quot;&gt;&lt;span style=&quot;font-size:10px&quot;&gt;BRANDS: 49 brands, 110 domains&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;+ profile_brand_impersonation(url, text)&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontFamily=Arial;fontColor=#1A1A1A;fontSize=10;align=center;verticalAlign=middle;spacing=6;strokeWidth=1.1;" vertex="1" parent="1"><mxGeometry x="20" y="470" width="250" height="120" as="geometry"/></mxCell><mxCell id="class_diagram-11" value="&lt;span style=&quot;font-size:10px&quot;&gt;«module»&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size:12px&quot;&gt;heuristic_engine&lt;/b&gt;&lt;hr style=&quot;margin:3px 0&quot;&gt;&lt;span style=&quot;font-size:10px&quot;&gt;+ analyze_url_heuristics(url)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;raw IP · &amp;#x27;@&amp;#x27; · IDN · TLD&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;subdomains · port · free hosting&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontFamily=Arial;fontColor=#1A1A1A;fontSize=10;align=center;verticalAlign=middle;spacing=6;strokeWidth=1.1;" vertex="1" parent="1"><mxGeometry x="310" y="470" width="250" height="120" as="geometry"/></mxCell><mxCell id="class_diagram-12" value="&lt;span style=&quot;font-size:10px&quot;&gt;«module»&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size:12px&quot;&gt;qr_payload&lt;/b&gt;&lt;hr style=&quot;margin:3px 0&quot;&gt;&lt;span style=&quot;font-size:10px&quot;&gt;+ decode_qr_image(image)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;+ classify_payload(text)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;+ extract_duitnow_accounts(text)&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontFamily=Arial;fontColor=#1A1A1A;fontSize=10;align=center;verticalAlign=middle;spacin