<mxfile host="drawio" type="device"><diagram name="class_diagram" id="class_diagram"><mxGraphModel dx="1200" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1169" pageHeight="827" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="class_diagram-1" value="&lt;span style=&quot;font-size:10px&quot;&gt;«pydantic»&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size:12px&quot;&gt;AnalyzeRequest&lt;/b&gt;&lt;hr style=&quot;margin:3px 0&quot;&gt;&lt;span style=&quot;font-size:10px&quot;&gt;url: str (http/https)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;dom_content ≤ 3 MB · text_content&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;screenshot (base64, optional)&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontFamily=Arial;fontColor=#1A1A1A;fontSize=10;align=center;verticalAlign=middle;spacing=6;strokeWidth=1.1;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="250" height="120" as="geometry"/></mxCell><mxCell id="class_diagram-2" value="&lt;span style=&quot;font-size:10px&quot;&gt;«module»&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size:12px&quot;&gt;analysis_pipeline&lt;/b&gt;&lt;hr style=&quot;margin:3px 0&quot;&gt;&lt;span style=&quot;font-size:10px&quot;&gt;PageInput (dataclass)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;+ async analyze_page(input, state)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;+ async scan_qr_code(image, state)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;+ is_trusted_host(host)&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontFamily=Arial;fontColor=#1A1A1A;fontSize=10;align=center;verticalAlign=middle;spacing=6;strokeWidth=1.1;" vertex="1" parent="1"><mxGeometry x="310" y="20" width="250" height="120" as="geometry"/></mxCell><mxCell id="class_diagram-3" value="&lt;span style=&quot;font-size:10px&quot;&gt;«pydantic»&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size:12px&quot;&gt;AnalysisResponse&lt;/b&gt;&lt;hr style=&quot;margin:3px 0&quot;&gt;&lt;span style=&quot;font-size:10px&quot;&gt;verdict · risk_level · risk_score · rule&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;headline · explanation · reasons&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;steps · signals · bert · mule&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontFamily=Arial;fontColor=#1A1A1A;fontSize=10;align=center;verticalAlign=middle;spacing=6;strokeWidth=1.1;" vertex="1" parent="1"><mxGeometry x="600" y="20" width="250" height="120" as="geometry"/></mxCell><mxCell id="class_diagram-4" value="&lt;span style=&quot;font-size:10px&quot;&gt;«dataclass»&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size:12px&quot;&gt;CanonicalURL&lt;/b&gt;&lt;hr style=&quot;margin:3px 0&quot;&gt;&lt;span style=&quot;font-size:10px&quot;&gt;hostname · skeleton_hostname · userinfo&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;is_ip · is_idn · display_url&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;+ canonicalize(url) → CanonicalURL&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontFamily=Arial;fontColor=#1A1A1A;fontSize=10;align=center;verticalAlign=middle;spacing=6;strokeWidth=1.1;" vertex="1" parent="1"><mxGeometry x="20" y="170" width="250" height="120" as="geometry"/></mxCell><mxCell id="class_diagram-5" value="&lt;span style=&quot;font-size:10px&quot;&gt;«module»&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size:12px&quot;&gt;verdict_engine&lt;/b&gt;&lt;hr style=&quot;margin:3px 0&quot;&gt;&lt;span style=&quot;font-size:10px&quot;&gt;+ decide(...) → Verdict&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;+ collect_signals(...)&lt;/