<mxfile host="drawio" type="device"><diagram name="decision_funnel" id="decision_funnel"><mxGraphModel dx="1200" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1169" pageHeight="827" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="decision_funnel-1" value='&lt;b style="font-size:13px"&gt;120 benchmark pages&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px"&gt;60 legitimate&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:12px"&gt;60 malicious&lt;/span&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontFamily=Arial;fontSize=12;fontColor=#1A1A1A;align=center;verticalAlign=middle;spacing=6;strokeWidth=1.1;" vertex="1" parent="1"><mxGeometry x="10" y="160" width="150" height="120" as="geometry"/></mxCell><mxCell id="decision_funnel-2" value="&lt;span style=&quot;font-size:11px&quot;&gt;Trusted-domain bypass: 19&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;18 legitimate · 1 malicious (*)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;HTTPS → SAFE, BERT not invoked&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontFamily=Arial;fontSize=11;fontColor=#1A1A1A;align=center;verticalAlign=middle;spacing=6;strokeWidth=1.1;" vertex="1" parent="1"><mxGeometry x="230" y="20" width="220" height="70" as="geometry"/></mxCell><mxCell id="decision_funnel-3" value="&lt;span style=&quot;font-size:11px&quot;&gt;Analysed: 101&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;BERT ║ mule scan ║ logo check&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;then brand, heuristics,&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;forms, lexicon, HTTPS&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontFamily=Arial;fontS