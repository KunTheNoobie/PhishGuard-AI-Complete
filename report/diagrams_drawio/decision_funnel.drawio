Align=middle;spacing=6;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="870" y="120" width="130" height="80" as="geometry"/></mxCell><mxCell id="decision_funnel-27" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.2;fontFamily=Arial;fontSize=10;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="decision_funnel-6" target="decision_funnel-26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="decision_funnel-28" value="&lt;span style=&quot;font-size:11px&quot;&gt;WARNING (H2): 1 malicious&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;SAFE, no rule: 43&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;42 legitimate · 1 malicious missed&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontFamily=Arial;fontSize=11;fontColor=#1A1A1A;align=center;verticalAlign=middle;spacing=6;strokeWidth=1.1;" vertex="1" parent="1"><mxGeometry x="520" y="330" width="300" height="70" as="geometry"/></mxCell><mxCell id="decision_funnel-29" value="no block rule" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.2;fontFamily=Arial;fontSize=10;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="decision_funnel-3" target="decision_funnel-28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="decision_funnel-30" value="v4.0 on the 120-page benchmark: blocked 57 of 60 malicious and 0 of 60 legitimate pages; one plain-HTTP fake form received an amber WARNING (H2) instead of being missed. Rules R7–R9 and H1 did not fire on this benchmark; they are exercised by the public URL suite. (*) One phishing form hosted on Google Forms, a trusted platform, bypassed analysis." style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#444444;fontStyle=0;spacing=2;" vertex="1" parent="1"><mxGeometry x="10" y="410" width="990" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
