<mxfile host="drawio" type="device"><diagram name="roadmap" id="roadmap"><mxGraphModel dx="1200" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1169" pageHeight="827" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="roadmap-1" value="Now (v3.2.0, measured)" style="swimlane;html=1;whiteSpace=wrap;startSize=26;rounded=1;arcSize=6;fillColor=#DAE8FC;swimlaneFillColor=#FFFFFF;strokeColor=#6C8EBF;fontFamily=Arial;fontSize=12;fontStyle=1;fontColor=#1A1A1A;collapsible=0;" vertex="1" parent="1"><mxGeometry x="10" y="10" width="300" height="135" as="geometry"/></mxCell><mxCell id="roadmap-2" value='&lt;span style="font-size:11px"&gt;• English URL BERT, random split&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;• 120-page authored benchmark&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;• 1 CPU worker ≈ 10 inferences / s&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;• SQLite + in-memory sessions&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;• simulated mule registry&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#1A1A1A;spacing=4;" vertex="1" parent="roadmap-1"><mxGeometry x="4" y="26" width="292" height="107" as="geometry"/></mxCell><mxCell id="roadmap-3" value="Next (data &amp;amp; capacity)" style="swimlane;html=1;whiteSpace=wrap;startSize=26;rounded=1;arcSize=6;fillColor=#D5E8D4;swimlaneFillColor=#FFFFFF;strokeColor=#82B366;fontFamily=Arial;fontSize=12;fontStyle=1;fontColor=#1A1A1A;collapsible=0;" vertex="1" parent="1"><mxGeometry x="350" y="10" width="300" height="135" as="geometry"/></mxCell><mxCell id="roadmap-4" value='&lt;span style="font-size:11px"&gt;• multilingual page-content model&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;• temporal, domain-disjoint evaluation&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;• real labelled Malaysian corpus&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;• distilled model, more workers&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;• shared session &amp;amp; rate-limit store&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#1A1A1A;spacing=4;" vertex="1" parent="roadmap-3"><mxGeometry x="4" y="26" width="292" height="107" as="geometry"/></mxCell><mxCell id="roadmap-5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.2;fontFamily=Arial;fontSize=10;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="roadmap-1" target="roadmap-3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="roadmap-6" value="Later (integration &amp;amp; operations)" style="swimlane;html=1;whiteSpace=wrap;startSize=26;rounded=1;arcSize=6;fillColor=#E1D5E7;swimlaneFillColor=#FFFFFF;strokeColor=#9673A6;fontFamily=Arial;fontSize=12;fontStyle=1;fontColor=#1A1A1A;collapsible=0;" vertex="1" parent="1"><mxGeometry x="690" y="10" width="300" height="135" as="geometry"/></mxCell><mxCell id="roadmap-7" value='&lt;span style="font-size:11px"&gt;• authorised NSRC / BNM data channels&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;• continuous retraining (MLflow)&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;• replicas behind a load balancer&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;• drift &amp;amp; false-positive monitoring&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;• independent security review&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#1A1A1A;spacing=4;" vertex="1" parent="roadmap-6"><mxGeometry x="4" y="26" width="292" height="107" as="geometry"/></mxCell><mxCell id="roadmap-8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.2;fontFamily=Arial;fontSize=10;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="roadmap-3" target="roadmap-6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>
