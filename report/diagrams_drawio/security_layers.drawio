<mxfile host="drawio" type="device"><diagram name="security_layers" id="security_layers"><mxGraphModel dx="1200" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1169" pageHeight="827" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="security_layers-1" value="Threat mitigated" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontColor=#B85450;fontStyle=1;spacing=2;" vertex="1" parent="1"><mxGeometry x="780" y="4" width="200" height="24" as="geometry"/></mxCell><mxCell id="security_layers-2" value="request path" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.2;fontFamily=Arial;fontSize=10;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;endArrow=block;strokeWidth=2;strokeColor=#333333;edgeStyle=none;verticalLabelPosition=middle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="18" y="40" as="sourcePoint"/><mxPoint x="18" y="690" as="targetPoint"/></mxGeometry></mxCell><mxCell id="security_layers-3" value="&lt;b style=&quot;font-size:11px&quot;&gt;L1  Client (Manifest V3)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;CSP script-src &amp;#x27;self&amp;#x27;; UI in closed Shadow DOM, text via textContent; HTTPS backend with local fallback; 8 s / 12 s timeouts; offline: HTTP never shown as safe&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontFamily=Arial;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="40" y="34" width="680" height="80" as="geometry"/></mxCell><mxCell id="security_layers-4" value='&lt;span style="font-size:11px"&gt;Malicious page script, stalled backend&lt;/span&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;fontFamily=Arial;fontSize=11;fontColor=#1A1A1A;align=center;verticalAlign=middle;spacing=6;strokeWidth=1.1;strokeColor=#B85450;fontColor=#8B2E2B;" vertex="1" parent="1"><mxGeometry x="780" y="46" width="210" height="56" as="geometry"/></mxCell><mxCell id="security_layers-5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.2;fontFamily=Arial;fontSize=10;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;strokeColor=#B85450;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="security_layers-4" target="security_layers-3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="security_layers-6" value="&lt;b style=&quot;font-size:11px&quot;&gt;L2  Edge policy&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;HTTPS at the platform edge + HSTS; CORS allow-list (no wildcard); nosniff · frame-ancestors · Referrer / Permissions-Policy · no-store&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontFamily=Arial;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="48" y="128" width="664" height="80" as="geometry"/></mxCell><mxCell id="security_layers-7" value='&lt;span style="font-size:11px"&gt;Cross-origin abuse, clickjacking, caching&lt;/span&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;fontFamily=Arial;fontSize=11;fontColor=#1A1A1A;align=center;verticalAlign=middle;spacing=6;strokeWidth=1.1;strokeColor=#B85450;fontColor=#8B2E2B;" vertex="1" parent="1"><mxGeometry x="780" y="140" width="210" height="56" as="geometry"/></mxCell><mxCell id="security_layers-8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.2;fontFamily=Arial;fontSize=10;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;strokeColor=#B85450;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="security_layers-7" target="security_layers-6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="security_layers-9" value="&lt;b style=&quot;font-size:11px&quot;&gt;L3  Authentication&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Analysis API: Bearer key, constant-time comparison; 13 dashboard operations: admin key or HttpOnly, Secure, SameSite=Strict session (8 h)&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#3B5B8C;fontFamily=Arial;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="56" y="222" width="648" height="80" as="geometry"/></mxCell><mxCell id="security_layers-10" value='&lt;span style="font-size:11px"&gt;Forged requests, SOC takeover&lt;/span&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;fontFamily=Arial;fontSize=11;fontColor=#1A1A1A;align=center;verticalAlign=middle;spacing=6;strokeWidth=1.1;strokeColor=#B85450;fontColor=#8B2E2B;" vertex="1" parent="1"><mxGeometry x="780" y="234" width="210" height="56" as="geometry"/></mxCell><mxCell id="security_layers-11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.2;fontFamily=Arial;fontSize=10;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;strokeColor=#B85450;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="security_layers-10" target="security_layers-9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="security_layers-12" value='&lt;b style="font-size:13px;color:#9673A6"&gt;L4  Abuse limits&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;SlowAPI per client IP: 60 / min on analysis and report endpoints; 5 / min on dashboard login&lt;/span&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontFamily=Arial;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="64" y="316" width="632" height="80" as="geometry"/></mxCell><mxCell id="security_layers-13" value='&lt;span style="font-size:11px"&gt;Flooding, online key guessing&lt;/span&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;fontFamily=Arial;fontSize=11;fontColor=#1A1A1A;align=center;verticalAlign=middle;spacing=6;strokeWidth=1.1;strokeColor=#B85450;fontColor=#8B2E2B;" vertex="1" parent="1"><mxGeometry x="780" y="328" width="210" height="56" as="geometry"/></mxCell><mxCell id="security_layers-14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.2;fontFamily=Arial;fontSize=10;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;strokeColor=#B85450;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="security_layers-13" target="security_layers-12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="security_layers-15" value="&lt;b style=&quot;font-size:11px&quot;&gt;L5  Input validation&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Pydantic v2: http(s) only, size caps, account pattern; URL canonicalisation; SSRF guard on live fetches (public IPs only)&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontFamily=Arial;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="72" y="410" width="616" height="80" as="geometry"/></mxCell><mxCell id="security_layers-16" value="Malformed input, &#x27;@&#x27; spoofing, SSRF" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;fontFamily=Arial;fontSize=11;fontColor=#1A1A1A;align=center;verticalAlign=middle;spacing=6;strokeWidth=1.1;strokeColor=#B85450;fontColor=#8B2E2B;" vertex="1" parent="1"><mxGeometry x="780" y="422" width="210" height="56" as="geometry"/></mxCell><mxCell id="security_layers-17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.2;fontFamily=Arial;fontSize=10;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;strokeColor=#B85450;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="security_layers-16" target="security_layers-15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="security_layers-18" value="&lt;b style=&quot;font-size:11px&quot;&gt;L6  Data integrity&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Parameterised SQL · CHECK / FK constraints; reports need analyst APPROVE; CSV export neutralises formulas&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontFamily=Arial;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="80" y="504" width="600" height="80" as="geometry"/></mxCell><mxCell id="security_layers-19" value='&lt;span style="font-size:11px"&gt;SQL injection, registry poisoning&lt;/span&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;fontFamily=Arial;fontSize=11;fontColor=#1A1A1A;align=center;verticalAlign=middle;spacing=6;strokeWidth=1.1;strokeColor=#B85450;fontColor=#8B2E2B;" vertex="1" parent="1"><mxGeometry x="780" y="516" width="210" height="56" as="geometry"/></mxCell><mxCell id="security_layers-20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.2;fontFamily=Arial;fontSize=10;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;strokeColor=#B85450;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="security_layers-19" target="security_layers-18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="security_layers-21" value="&lt;b style=&quot;font-size:11px&quot;&gt;L7  Fault tolerance&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;fetch errors reported, never fatal; scan-log failures never block a verdict; models loaded once at start-up&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontFamily=Arial;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="88" y="598" width="584" height="80" as="geometry"/></mxCell><mxCell id="security_layers-22" value='&lt;span style="font-size:11px"&gt;Model fault, partial failure&lt;/span&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;fontFamily=Arial;fontSize=11;fontColor=#1A1A1A;align=center;verticalAlign=middle;spacing=6;strokeWidth=1.1;strokeColor=#B85450;fontColor=#8B2E2B;" vertex="1" parent="1"><mxGeometry x="780" y="610" width="210" height="56" as="geometry"/></mxCell><mxCell id="security_layers-23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.2;fontFamily=Arial;fontSize=10;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;strokeColor=#B85450;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="security_layers-22" target="security_layers-21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>
