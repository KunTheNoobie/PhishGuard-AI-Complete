<mxfile host="drawio" type="device"><diagram name="kill_chain" id="kill_chain"><mxGraphModel dx="1200" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1169" pageHeight="827" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="kill_chain-1" value="1  Lure delivery" style="swimlane;html=1;whiteSpace=wrap;startSize=26;rounded=1;arcSize=6;fillColor=#DAE8FC;swimlaneFillColor=#FFFFFF;strokeColor=#6C8EBF;fontFamily=Arial;fontSize=12;fontStyle=1;fontColor=#1A1A1A;collapsible=0;" vertex="1" parent="1"><mxGeometry x="10" y="10" width="215" height="120" as="geometry"/></mxCell><mxCell id="kill_chain-2" value='&lt;span style="font-size:11px"&gt;SMS · WhatsApp · Telegram&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;social and marketplace ads&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;QR posters · fake e-mail&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;caller posing as PDRM / LHDN&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#1A1A1A;spacing=4;" vertex="1" parent="kill_chain-1"><mxGeometry x="4" y="26" width="207" height="92" as="geometry"/></mxCell><mxCell id="kill_chain-3" value="2  Deception surface" style="swimlane;html=1;whiteSpace=wrap;startSize=26;rounded=1;arcSize=6;fillColor=#E1D5E7;swimlaneFillColor=#FFFFFF;strokeColor=#9673A6;fontFamily=Arial;fontSize=12;fontStyle=1;fontColor=#1A1A1A;collapsible=0;" vertex="1" parent="1"><mxGeometry x="255" y="10" width="215" height="120" as="geometry"/></mxCell><mxCell id="kill_chain-4" value='&lt;span style="font-size:11px"&gt;look-alike / punycode domain&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;pixel-copied bank login&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;urgent BM / Manglish text&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;fake listing or aid portal&