<mxfile host="drawio" type="device"><diagram name="deployment" id="deployment"><mxGraphModel dx="1200" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1169" pageHeight="827" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="deployment-1" value="«device» User computer" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=14;fillColor=#FFFFFF;strokeColor=#82B366;fontFamily=Arial;fontSize=12;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="10" y="10" width="330" height="330" as="geometry"/></mxCell><mxCell id="deployment-2" value="«execution env.» Google Chrome" style="swimlane;html=1;whiteSpace=wrap;startSize=26;rounded=1;arcSize=6;fillColor=#D5E8D4;swimlaneFillColor=#FFFFFF;strokeColor=#82B366;fontFamily=Arial;fontSize=12;fontStyle=1;fontColor=#1A1A1A;collapsible=0;" vertex="1" parent="1"><mxGeometry x="30" y="60" width="280" height="110" as="geometry"/></mxCell><mxCell id="deployment-3" value="&lt;span style=&quot;font-size:11px&quot;&gt;PhishGuard-AI extension (Manifest V3)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;backend: online HTTPS server, local fallback&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#1A1A1A;spacing=4;" vertex="1" parent="deployment-2"><mxGeometry x="4" y="26" width="272" height="82" as="geometry"/></mxCell><mxCell id="deployment-4" value="Dashboard tab" style="swimlane;html=1;whiteSpace=wrap;startSize=26;rounded=1;arcSize=6;fillColor=#D5E8D4;swimlaneFillColor=#FFFFFF;strokeColor=#82B366;fontFamily=Arial;fontSize=12;fontStyle=1;fontColor=#1A1A1A;collapsible=0;" vertex="1" parent="1"><mxGeometry x="30" y="200" width="280" height="110" as="geometry"/></mxCell><mxCell id="deployment-5" value="&lt;span style=&quot;font-size:11px&quot;&gt;/dashboard/ over HTTPS&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;HttpOnly, Secure session cookie&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#1A1A1A;spacing=4;" vertex="1" parent="deployment-4"><mxGeometry x="4" y="26" width="272" height="82" as="geometry"/></mxCell><mxCell id="deployment-6" value="«cloud» Render Cloud — phishguard-ai-backend-j74v.onrender.com (free tier, HTTPS at the edge)" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=14;fillColor=#FFFFFF;strokeColor=#3B5B8C;fontFamily=Arial;fontSize=12;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="480" y="10" width="560" height="330" as="geometry"/></mxCell><mxCell id="deployment-7" value="«process» uvicorn main:app — $PORT (10000), proxy headers trusted" style="swimlane;html=1;whiteSpace=wrap;startSize=26;rounded=1;arcSize=6;fillColor=#DAE8FC;swimlaneFillColor=#FFFFFF;strokeColor=#6C8EBF;fontFamily=Arial;fontSize=12;fontStyle=1;fontColor=#1A1A1A;collapsible=0;" vertex="1" parent="1"><mxGeometry x="500" y="60" width="520" height="120" as="geometry"/></mxCell><mxCell id="deployment-8" value="&lt;span style=&quot;font-size:10px&quot;&gt;FastAPI event loop · worker threads for BERT and YOLOv8n&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;BERT 438 MB in RAM · YOLOv8n 6.2 MB · result cache 600 s&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;env / secrets: PHISHGUARD_API_KEY · _ADMIN_KEY · _RATE_LIMIT&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#1A1A1A;spacing=4;" vertex="1" parent="deployment-7"><mxGeometry x="4" y="26" width="512" height="92" as="geometry"/></mxCell><mxCell id="deployment-9" value="&lt;span style=&quot;font-size:10px&quot;&gt;«artifact» phishguard.db&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;SQLite in /tmp (reset on restart)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;3 tables · 4 indexes&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#FFF2CC;strokeColor=#D6B656;fontFamily=Arial;fontSize=11;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="510" y="210" width="230" height="100" as="geometry"/></mxCell><mxCell id="deployment-10" value="&lt;span style=&quot;font-size:10px&quot;&gt;«artifact» Model files (Git LFS)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;phishguard_custom_model/&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;visual_identity/models/best.pt&lt;/span&gt;" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontFamily=Arial;fontSize=12;" vertex="1" parent="1"><mxGeometry x="775" y="215" width="240" height="90" as="geometry"/></mxCell><mxCell id="deployment-11" value="&lt;span style=&quot;font-size:11px&quot;&gt;HTTPS :443&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Bearer key&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.2;fontFamily=Arial;fontSize=10;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.3;" edge="1" parent="1" source="deployment-2" target="deployment-7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="deployment-12" value="&lt;span style=&quot;font-size:11px&quot;&gt;HTTPS&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;session cookie&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.2;fontFamily=Arial;fontSize=10;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.8;" edge="1" parent="1" source="deployment-4" target="deployment-7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="deployment-13" value="aiosqlite" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.2;fontFamily=Arial;fontSize=10;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=5 4;exitX=0.2;exitY=1;entryX=0.5;entryY=0;endArrow=open;" edge="1" parent="1" source="deployment-7" target="deployment-9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="deployment-14" value="loaded at start-up" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.2;fontFamily=Arial;fontSize=10;fontColor=#1A1A1A;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=5 4;exitX=0.8;exitY=1;entryX=0.5;entryY=0;endArrow=open;" edge="1" parent="1" source="deployment-7" target="deployment-10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="deployment-15" value="Development and fallback: the same image runs with docker compose (port 8000) or uvicorn on 127.0.0.1:8000. The extension tries the online server first and switches to the local one automatically. Outbound internet access is used only by the safe page fetcher." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=11;fontColor=#444444;fontStyle=0;spacing=2;" vertex="1" parent="1"><mxGeometry x="10" y="350" width="1000" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
