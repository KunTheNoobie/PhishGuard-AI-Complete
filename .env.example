# ==============================================================================
# PhishGuard-AI v3.2.0 — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust the values:
#     cp .env.example .env        (Windows: copy .env.example .env)
#
# core/config.py loads .env automatically through python-dotenv. Real
# environment variables always take precedence over this file.
# ==============================================================================

# --- Security & Authentication ---
# API key sent by the Chrome extension (Authorization: Bearer <key>).
# The value below is the public development default: CHANGE IT before any
# deployment outside a local demonstration, e.g.
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
PHISHGUARD_API_KEY=phishguard_secret_key_2026

# Administrative key for the SOC dashboard (/api/v1/dashboard/*): registry
# deletion, database backup, exports. Leave empty to reuse PHISHGUARD_API_KEY
# (single-key development mode). Use a distinct value in production.
PHISHGUARD_ADMIN_KEY=

# Lifetime of a dashboard browser session in seconds (default 8 hours).
PHISHGUARD_SESSION_TTL=28800

# Comma-separated browser origins allowed by CORS. Chrome extension origins
# (chrome-extension://<id>) are always allowed; "*" is never used.
PHISHGUARD_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# --- Rate Limiting (SlowAPI format: <count>/<second|minute|hour|day>) ---
# Per client IP. 60/minute is the shipped default. Load tests in
# the "Evaluation artefacts" section of README.md document the value they used.
PHISHGUARD_RATE_LIMIT=60/minute

# --- Database Path (SQLite WAL mode) ---
PHISHGUARD_DB_PATH=phishguard.db

# --- AI / Machine Learning Engine ---
# Set to 'false' to run without loading the PyTorch BERT model.
PHISHGUARD_ENABLE_SEMANTIC=true

# BERT model path or Hugging Face repo identifier.
PHISHGUARD_BERT_MODEL=./phishguard_custom_model

# Minimum softmax confidence for the BERT "PHISHING" label to count as a
# positive signal (0.0 to 1.0). A BERT signal never blocks a page on its own.
PHISHGUARD_MALICIOUS_THRESHOLD=0.75

# Visual YOLOv8 model path and confidence threshold.
PHISHGUARD_VISUAL_MODEL=visual_identity/models/best.pt
PHISHGUARD_VISUAL_CONFIDENCE=0.85
