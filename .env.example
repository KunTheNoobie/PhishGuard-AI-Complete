# ==============================================================================
# PhishGuard-AI — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust variables as needed:
# cp .env.example .env
# ==============================================================================

# --- Security & Authentication ---
PHISHGUARD_API_KEY=phishguard_secret_key_2026

# --- Rate Limiting (SlowAPI format: <count>/<minute|hour|day>) ---
PHISHGUARD_RATE_LIMIT=30/minute

# --- Database Path (SQLite WAL mode) ---
PHISHGUARD_DB_PATH=phishguard.db

# --- AI / Machine Learning Engine ---
# Set to 'false' to run in visual-only mode without loading PyTorch BERT model
PHISHGUARD_ENABLE_SEMANTIC=true

# BERT Model path or HuggingFace repo identifier
PHISHGUARD_BERT_MODEL=./phishguard_custom_model

# Confidence threshold to trigger BLOCK_RENDER verdict (0.0 to 1.0)
PHISHGUARD_MALICIOUS_THRESHOLD=0.75

# Visual YOLOv8 Model path and confidence threshold
PHISHGUARD_VISUAL_MODEL=visual_identity/models/best.pt
PHISHGUARD_VISUAL_CONFIDENCE=0.85
