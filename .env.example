# ==============================================================================
# PhishGuard-AI v4.0 — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust the values:
#     copy .env.example .env        (macOS / Linux: cp .env.example .env)
#
# core/config.py loads .env automatically. Real environment variables (for
# example Hugging Face Space secrets) always take precedence over this file.
# ==============================================================================

# --- Keys ---
# API key the browser extension sends as "Authorization: Bearer <key>".
PHISHGUARD_API_KEY=12345678
# Admin key for the SOC dashboard sign-in and /api/v1/dashboard routes.
# 12345678 is the shared demonstration key. For any real deployment set long
# random values, e.g.  python -c "import secrets; print(secrets.token_urlsafe(32))"
PHISHGUARD_ADMIN_KEY=12345678

# Dashboard session lifetime in seconds (default 8 hours).
PHISHGUARD_SESSION_TTL=28800

# --- CORS ---
# Browser origins allowed to call the API. Extension pages are always allowed;
# "*" is never used. The dashboard is same-origin and needs no entry.
PHISHGUARD_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# --- Rate limit per client IP (SlowAPI format) ---
PHISHGUARD_RATE_LIMIT=60/minute

# --- Database (SQLite, WAL mode) ---
PHISHGUARD_DB_PATH=phishguard.db

# --- Models ---
PHISHGUARD_ENABLE_SEMANTIC=true
PHISHGUARD_BERT_MODEL=./phishguard_custom_model
# P(phishing) at or above which BERT counts as a signal. BERT never blocks alone.
PHISHGUARD_MALICIOUS_THRESHOLD=0.75
PHISHGUARD_ENABLE_VISUAL=true
PHISHGUARD_VISUAL_MODEL=visual_identity/models/best.pt
PHISHGUARD_VISUAL_CONFIDENCE=0.85

# --- Live page fetching (dashboard URL analyser and QR scanner) ---
PHISHGUARD_FETCH_TIMEOUT=8
PHISHGUARD_FETCH_MAX_BYTES=1500000
